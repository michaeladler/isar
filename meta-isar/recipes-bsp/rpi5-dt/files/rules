%:
	dh $@

override_dh_install:
	rpm2cpio rpi5-dt.rpm | cpio -idmv
	install -d debian/rpi5-dt/usr/lib/rpi5-dt
	cp boot/vc/*.dtb debian/rpi5-dt/usr/lib/rpi5-dt
	cp -r boot/vc/overlays debian/rpi5-dt/usr/lib/rpi5-dt
