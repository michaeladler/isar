# rpi5: fix U-Boot from being stuck at the U-Boot logo when there is no UART connected
# see https://lists.denx.de/pipermail/u-boot/2025-January/576305.html

CONFIG_AUTOBOOT_KEYED=y
# CONFIG_AUTOBOOT_FLUSH_STDIN is not set
CONFIG_AUTOBOOT_PROMPT="Autoboot in %d seconds\n"
# CONFIG_AUTOBOOT_ENCRYPTION is not set
CONFIG_AUTOBOOT_DELAY_STR=""
CONFIG_AUTOBOOT_STOP_STR=" "
# CONFIG_AUTOBOOT_KEYED_CTRLC is not set
# CONFIG_BOOT_RETRY is not set
